SEASON_ID=44
TEAM_A_ID=1977
TEAM_B_ID=17541
APP_PASSWORD=byt-ut-mig
# Bas-URL till iBIS publika API. Har bytts en gång: sökvägen utan /public/
# svarar 403. Sätt bara om iBIS flyttar endpointerna igen.
IBIS_BASE_URL=https://api.innebandy.se/v2/api/public
# Antal dygn efter kickoff som en färdigrapporterad match fortsätter hämtas om,
# så att rättelser i trupp och resultat fångas. 0 stänger av fönstret: då fryser
# underlaget när slutresultatet rapporterats, och rättelser kräver
# python -m app.refresh_match <match-id>.
RESYNC_WINDOW_DAYS=3
# Lokalt: relativ fil. På Railway: peka mot den monterade volymen,
# t.ex. DATABASE_URL=sqlite:////data/spelbarhet.db
DATABASE_URL=sqlite:///./tungelsta.db
